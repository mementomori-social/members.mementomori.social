{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "members-mementomori-social",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"vars": { "ORIGIN": "https://members.mementomori.social" },
	"routes": [{ "pattern": "members.mementomori.social", "custom_domain": true }],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mementomori-members",
			// Placeholder id: local dev (miniflare) ignores it. Replace with the
			// real id from `wrangler d1 create mementomori-members` before deploy.
			"database_id": "11f4772b-1c68-49a9-b381-5ea93dbe1906",
			"migrations_dir": "drizzle"
		}
	]
}
