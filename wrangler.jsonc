{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "members-mementomori-social",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Versioned preview URLs would serve the real member register from an
	// unlisted workers.dev host. The custom domain is the only entrance.
	"preview_urls": false,
	"vars": { "ORIGIN": "https://members.mementomori.social" },
	"routes": [{ "pattern": "members.mementomori.social", "custom_domain": true }],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mementomori-members",
			// The live production database. Reaching it still requires an
			// account-scoped Cloudflare token, so the id alone grants nothing.
			// Changing it orphans the local dev data, which is keyed by this id.
			"database_id": "11f4772b-1c68-49a9-b381-5ea93dbe1906",
			"migrations_dir": "drizzle"
		}
	]
}
